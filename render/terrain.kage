//kage:unit pixels
package renderer

// Fixed
var Apron float
var ChunkSize float
var Zoom float
var Origin vec2

// Lighting
var LightPos vec2
var LightIntensity float
var Ambient float

// Levels
var SeaLevel float
var BeachLevel float
var PlainLevel float
var HillLevel float
var MountainLevel float

// Colors
var WaterDeepColor vec3
var WaterShallowColor vec3
var BeachColor vec3
var PlainColor vec3
var HillColor vec3
var MountainColor vec3
var SnowColor vec3

// Normals
var NormalStrength float
var NormalEps float

func Fragment(dstPos vec4, srcPos vec2, color vec4) vec4 {
    // --- local coords in chunk texture space ---
    local := (dstPos.xy - Origin) / Zoom

    a := Apron
    n := ChunkSize

    // Skip apron
    if local.x < a || local.y < a || local.x >= a+n || local.y >= a+n {
        return vec4(0.0)
    }

    // --- height sampling ---
    p := srcPos
    h := imageSrc0UnsafeAt(p).r

    // --- normal from heightmap ---
    hx1 := imageSrc0UnsafeAt(p + vec2(NormalEps, 0.0)).r
    hx0 := imageSrc0UnsafeAt(p - vec2(NormalEps, 0.0)).r
    hy1 := imageSrc0UnsafeAt(p + vec2(0.0, NormalEps)).r
    hy0 := imageSrc0UnsafeAt(p - vec2(0.0, NormalEps)).r

    inv2e := 0.5 / max(NormalEps, 0.0001)
    dx := (hx1 - hx0) * inv2e
    dy := (hy1 - hy0) * inv2e

    N := normalize(vec3(-dx*NormalStrength, -dy*NormalStrength, 1.0))

    // --- lighting vectors ---
    // Fragment position in screen space
    fragPos := dstPos.xy

    // Light direction from fragment to light
    L := normalize(vec3(LightPos - fragPos, 200.0))
    V := vec3(0.0, 0.0, 1.0) // camera looks straight down

    ndotl := clamp(dot(N, L), 0.0, 1.0)

    diffuse := Ambient + (1.0 - Ambient) * ndotl * LightIntensity

    // --- biome color ---
    var base vec3

    // ===== WATER =====
    if h < SeaLevel {
        // Depth factor [0..1]
        t := h / SeaLevel

        // Base water color (deep -> shallow)
        base = mix(WaterDeepColor, WaterShallowColor, t)

        // Flat normal for water
        Nw := vec3(0.0, 0.0, 1.0)

        // Lighting vectors
        ndotlW := clamp(dot(Nw, L), 0.0, 1.0)

        // Diffuse lighting (responds to Ambient + LightIntensity)
        waterDiffuse := Ambient + (1.0 - Ambient) * ndotlW * LightIntensity

        // Keep water flatter and brighter than land
        waterDiffuse = mix(0.65, 1.0, waterDiffuse)

        // Specular reflection (Blinn–Phong)
        H := normalize(L + V)
        spec := pow(clamp(dot(Nw, H), 0.0, 1.0), 80.0)

        // Stronger spec near coast
        coast := smoothstep(0.7, 1.0, t)

        // Final water color
        colorOut := base * waterDiffuse
        colorOut += vec3(1.0) * spec * coast * 0.35 * LightIntensity

        return vec4(clamp(colorOut, 0.0, 1.0), 1.0)
    }

    // ===== LAND =====
    t := (h - SeaLevel) / (1.0 - SeaLevel)

    if t < BeachLevel {
        base = BeachColor

    } else if t < PlainLevel {
        base = PlainColor

    } else if t < HillLevel {
        base = HillColor

    } else if t < MountainLevel {
        base = MountainColor

    } else {
        base = SnowColor
        diffuse = 0.45 + 0.65 * ndotl * LightIntensity
    }

    // cheap AO from slope
    slope := clamp((abs(dx) + abs(dy)) * NormalStrength * 0.35, 0.0, 1.0)
    ao := 1.0 - 0.25 * slope

    col := base * diffuse * ao
    return vec4(clamp(col, 0.0, 1.0), 1.0)
}
