//kage:unit pixels
package renderer

var ColorFrom vec3
var ColorTo vec3

var Edge float
var Smooth float

func Fragment(dstPos vec4, srcPos vec2, color vec4) vec4 {
	h := imageSrc0UnsafeAt(srcPos).r
	w := max(Smooth*0.5, 1e-6)
	t := smoothstep(Edge-w, Edge+w, h)
	col := mix(ColorFrom, ColorTo, t)
	return vec4(col, 1.0)
}
